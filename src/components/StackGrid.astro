---
import { stack } from '../data/stack';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="grid" id="stackGrid">
  {
    stack.map((category) => (
      <div class="card">
        <h3>{category.name[locale]}</h3>
        <ul class="chips">
          {category.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))
  }
</div>
